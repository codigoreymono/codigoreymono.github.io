---
import Layout from "@/layouts/default.astro";
---

<Layout title="404 — bash: command not found">
  <div class="font-mono my-6 leading-relaxed">
    <p>
      <span class="text-accent">$</span>
      cd
      <span class="text-fg">/portfolio/this-page</span>
    </p>

    <p class="text-dim">
      bash: cd: /portfolio/this-page: No such file or directory
    </p>

    <p>&nbsp;</p>

    <p>
      <span class="text-accent">$</span>
      man
      <span class="text-fg">portfolio</span>
    </p>

    <p class="text-dim">No manual entry for portfolio</p>

    <p>&nbsp;</p>

    <p>
      <span class="text-accent">$</span>
      <a href="/" class="text-accent hover:underline">cd ~</a>
    </p>

    <p class="text-dim">→ back to home</p>

    <p>&nbsp;</p>

    <p>
      <span class="text-accent">$</span>
      <span class="text-border">_</span>
    </p>
  </div>
</Layout>
