---
import SectionTitle from "@/components/section-title.astro";
import Btop from "@/components/tui/btop/index.astro";
import Lazygit from "@/components/tui/lazygit/index.astro";
import Mutt from "@/components/tui/mutt/index.astro";
import Ranger from "@/components/tui/ranger/index.astro";
import Layout from "@/layouts/default.astro";
---

<Layout
  title="astro-distro"
  description="astro-distro — Astro + Tailwind fastfetch-style portfolio template"
>
  <section id="about" class="my-10">
    <SectionTitle title="about" />
    <Lazygit />
  </section>

  <section id="projects" class="my-10">
    <SectionTitle title="projects" />
    <Ranger />
  </section>

  <section id="uses" class="my-10">
    <SectionTitle title="uses" />
    <Btop />
  </section>

  <section id="contact" class="my-10">
    <SectionTitle title="contact" />
    <Mutt />
  </section>
</Layout>
