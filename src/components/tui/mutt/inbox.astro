---
export interface Mail {
  from: string;
  href: string;
}

export interface Props {
  mails: Mail[];
}

const { mails } = Astro.props;
---

<div class="font-mono my-2 flex flex-col gap-1">
  {
    mails.map(({ from, href }) => (
      <a
        class="w-fit text-c2 hover:text-accent hover:cursor-pointer"
        href={href}
        target={href.startsWith("mailto:") ? undefined : "_blank"}
        rel={href.startsWith("mailto:") ? undefined : "noopener"}
      >
        {from}
      </a>
    ))
  }
</div>
