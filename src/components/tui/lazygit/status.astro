---
import Container from "@/components/tui/commons/container.astro";
import Content from "@/components/tui/commons/content.astro";
import Label from "@/components/tui/commons/label.astro";
import Paragraph from "@/components/tui/commons/paragraph.astro";

export interface Props {
  status: {
    branch: string;
    since: number;
  };
}

const { status } = Astro.props;
---

<Container>
  <Label>status</Label>
  <Content>
    <Paragraph class="flex-wrap gap-0">
      <span class="font-medium text-accent mr-3">
        ⎇ {status.branch}
      </span>

      <span class="text-dim">
        · since {status.since}
      </span>
    </Paragraph>
  </Content>
</Container>
